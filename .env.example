# Environment Configuration Template: ENVORA
# Copy this file to .env for local configuration.
# IMPORTANT: NEVER commit private credentials, Wi-Fi passwords, or auth tokens to version control.

# ThingSpeak Configuration
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_WRITE_API_KEY=

# Blynk Configuration
BLYNK_TEMPLATE_ID=
BLYNK_TEMPLATE_NAME=
BLYNK_AUTH_TOKEN=

# Wi-Fi Credentials (Used in firmware config.h, NEVER commit actual values)
WIFI_SSID=
WIFI_PASSWORD=

# Application Mode (LIVE or DEMO)
APP_MODE=DEMO
